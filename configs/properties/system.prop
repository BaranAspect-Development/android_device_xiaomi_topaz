persist.log.tag.AudioPolicyService=E
persist.log.tag.DisplayFeatureHal=E
persist.log.tag.qti_sensors_hal=E
persist.log.tag.BluetoothAdapterService=E

# LMKD
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=15
